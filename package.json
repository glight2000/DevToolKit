{
  "name": "devtoolkit",
  "version": "1.0.0",
  "description": "DevToolkit - A multi-tool desktop toolkit for developers",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run prepare:native && node scripts/build-desktop.mjs && electron-vite dev",
    "build": "npm run prepare:native && node scripts/build-desktop.mjs && npm run typecheck && electron-vite build",
    "prepare:native": "node scripts/prepare-native.mjs",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "package:dir": "npm run build && electron-builder --config electron-builder.yml --dir --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test tests/core.test.ts tests/ssh-config.test.ts tests/ssh-connections.test.ts tests/desktop.test.ts tests/subscriptions.test.ts tests/local-subscriptions.test.ts tests/paragraphs.test.ts tests/launcher.test.ts",
    "test:subscriptions": "npm run build && node tests/subscriptions-smoke.mjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs",
    "test:desktop-gestures": "node tests/desktop-gesture-smoke.mjs",
    "test:smoke": "npm run build && node tests/electron-smoke.mjs",
    "test:ssh": "npm run build && node tests/ssh-workspace-smoke.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-store": "^11.0.2",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.53.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  }
}
